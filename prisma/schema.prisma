generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Application {
  id              String    @id @default(cuid())
  clerkUserId     String    @map("clerk_user_id")
  company         String
  role            String
  jobType         String    @default("Job")         @map("job_type")
  applyType       String    @default("Direct Apply") @map("apply_type")
  platform        String?
  jobLink         String?   @map("job_link")
  dateApplied     DateTime? @map("date_applied")    @db.Date
  status          String    @default("Applied")
  workType        String    @default("Onsite")      @map("work_type")
  followUpDate    DateTime? @map("follow_up_date")  @db.Date
  salary          String?
  resumeVersion   String?   @map("resume_version")
  notes           String?
  rejectionReason String?   @map("rejection_reason")
  notifyEmail     String?   @map("notify_email")

  statusHistory   Json      @default("[]")          @map("status_history")
  createdAt       DateTime  @default(now())         @map("created_at")
  updatedAt       DateTime  @updatedAt              @map("updated_at")
  
  notifications   Notification[]
  @@index([clerkUserId])
  @@index([clerkUserId, status])
  @@map("applications")
}






model Notification {
  id          String   @id @default(cuid())
  clerkUserId String   @map("clerk_user_id")

  type        String   // "application_added" | "followup_reminder" | "status_change"
  title       String
  body        String
  read        Boolean  @default(false)

  applicationId String?      @map("application_id")
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([clerkUserId, read])
  @@index([clerkUserId, createdAt])
  @@map("notifications")
}